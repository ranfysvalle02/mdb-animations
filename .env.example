# Required (local Compose and Render alike)
VOYAGE_API_KEY=
GEMINI_API_KEY=

# Leave MONGODB_URI unset locally to use the bundled Atlas Local container.
# For Render or hosted Atlas: mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/
# MONGODB_URI=
MONGODB_DB=animation_studio

# Accounts (m-stash). Defaults point at Inkling's app; the pk_ key is publishable.
# MSTASH_APP_KEY=pk_...
# MSTASH_APP_ID=
# INKLING_AUTH=off            # offline, single-user studio (no sign-in)

# Hosting (Render sets PORT itself)
PORT=8000
# INKLING_SETUP_ON_START=0    # skip building indexes on boot (default on; Compose uses its setup job)
# INKLING_SEED_DEMO=0         # skip seeding the shared demo library (default on, once)
# TRUST_PROXY=1               # behind a TLS proxy: Secure cookies, real client IPs
# PUBLIC_URL=https://inkling.example.com   # absolute URL for link previews (Render sets RENDER_EXTERNAL_URL)

# Per-member hourly budgets for billable calls (0 = unlimited)
# INKLING_AI_PER_HOUR=60
# INKLING_EMBEDS_PER_HOUR=600

# Optional model overrides
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# CODE_EMBED_MODEL=voyage-code-4   # Atlas Automated Embedding model for scene code
